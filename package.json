{
  "name": "nyc-map-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run puzzles:build && tsc -b && vitest run && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:tiles": "node scripts/check-tiles.mjs",
    "check:db": "CHECK_EVENTS_DB=1 vitest run tests/events-roundtrip.test.ts tests/config-roundtrip.test.ts",
    "test": "vitest run",
    "puzzles:build": "node scripts/build-puzzles.mjs",
    "predev": "npm run puzzles:build",
    "pretest": "npm run puzzles:build"
  },
  "dependencies": {
    "maplibre-gl": "^6.4.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
